{
  "name": "my-diary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "本地日记 · 加密存储 · Electron 桌面版",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"node server/server.js\" \"vite\"",
    "start": "concurrently -n server,web,gate -c cyan,magenta,yellow \"node server/server.js\" \"vite\" \"node tools/open-browser.mjs\"",
    "build": "vite build",
    "server": "node server/server.js",
    "electron": "vite build && electron .",
    "dist:win": "vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.mydiary.local",
    "productName": "MyDiary",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyDiary",
      "artifactName": "MyDiary-Setup-${version}.exe"
    },
    "forceCodeSigning": false
  }
}
